# Project Buddy — Resend Email Delivery Environment Variables

# Resend API Key (Secret Key from resend.com/api-keys)
RESEND_API_KEY=re_123456789_your_resend_api_key

# Sender Address (Verified Domain hello@projectbuddy.co.in)
EMAIL_FROM=Project Buddy <hello@projectbuddy.co.in>

# Recipient Email Addresses (Comma-separated)
EMAIL_TO=info@projectbuddy.co.in,projectbuddy.code@gmail.com
